# Sentinel-X Backend Environment Variables (Development)

# Application
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sentinel_x

# Redis
REDIS_URL=redis://redis:6379/0

# API Configuration
API_DOCS_URL=/docs
API_OPENAPI_URL=/openapi.json

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=jwt-secret-key-change-in-production-min-32

# Logging
LOG_LEVEL=INFO

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
